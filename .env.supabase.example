# PostgreSQL / Supabase Configuration (for production)
# Use this when ready to migrate from SQLite to Supabase
#
# Steps to migrate:
# 1. Create Supabase project at https://supabase.com
# 2. Go to Settings → Database → Connection Pooling
# 3. Copy the PostgreSQL connection string
# 4. Update prisma/schema.prisma: provider = "postgresql"
# 5. Update .env with DATABASE_URL below
# 6. Run: npm run db:migrate && npm run seed
#

DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-a-strong-random-secret-here"
NEXTAUTH_URL="https://www.vipulanantha.sch.lk"

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Storage
STORAGE_PROVIDER="supabase"

# AI Provider (choose one)
AI_PROVIDER="mock"
# OR
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GEMINI_API_KEY="..."

# Public URLs
NEXT_PUBLIC_SITE_URL="https://www.vipulanantha.sch.lk"
NEXT_PUBLIC_SPORTS_URL="https://sports.vipulanantha.sch.lk"
NEXT_PUBLIC_ADMIN_URL="https://admin.vipulanantha.sch.lk"
